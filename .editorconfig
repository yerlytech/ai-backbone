root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Dart is here because `dart format` writes 2 spaces (measured on Dart 3.13.4),
# and an editor told 4 fights the formatter on every save.
[*.{js,jsx,ts,tsx,dart,json,yaml,yml,html,css,scss}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Justfile]
indent_size = 4
